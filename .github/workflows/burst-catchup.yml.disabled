name: Burst catchup (block + MEV indexers)

# Runs every 30 min. Checks lag via /api/v1/indexer/status. Bursts up to
# 8 block-indexer calls + 4 MEV calls if drifting. Idle when caught up.
#
# Concurrency: queue (don't cancel) so back-to-back schedules don't kill
# in-flight progress. Timeout raised to 14 min to fit 8 bursts + retries.

on:
  schedule:
    - cron: "*/30 * * * *"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  burst:
    runs-on: ubuntu-latest
    timeout-minutes: 14
    concurrency:
      group: burst-catchup
      cancel-in-progress: false
    steps:
      - name: Check lag and burst-catchup if drifting
        env:
          CRON_SECRET: ${{ secrets.CRON_SECRET }}
        run: |
          BASE="https://monad-income-tracker.vercel.app"
          LAG_THRESHOLD=50000
          MAX_BURSTS=8

          call_with_retry() {
            local url="$1"
            local attempt body code
            for attempt in 1 2 3; do
              body=$(curl -sS --max-time 65 \
                -H "Authorization: Bearer ${CRON_SECRET}" \
                -w "\n__HTTP__%{http_code}" \
                "$url" 2>/dev/null)
              code=$(printf '%s' "$body" | tail -1 | sed 's/__HTTP__//')
              if [ "$code" = "200" ]; then
                printf '%s' "$body" | sed '$d'
                return 0
              fi
              echo "  attempt $attempt failed (http=$code), retrying..." >&2
              sleep 2
            done
            echo "  all 3 attempts failed" >&2
            return 0
          }

          read_lag() {
            local lag
            lag=$(curl -sS --max-time 10 "$BASE/api/v1/indexer/status" 2>/dev/null | \
              jq -r '.lagBlocks // 0' 2>/dev/null | tr -cd '0-9')
            [ -z "$lag" ] && lag=0
            echo "$lag"
          }

          block_lag=$(read_lag)
          echo "block indexer lag: $block_lag blocks (threshold $LAG_THRESHOLD)"

          if [ "$block_lag" -gt "$LAG_THRESHOLD" ]; then
            echo "lag exceeds threshold, bursting up to $MAX_BURSTS block-indexer calls"
            i=1
            while [ "$i" -le "$MAX_BURSTS" ]; do
              echo "--- block call $i ---"
              call_with_retry "$BASE/api/cron/index-blocks" | \
                jq -r '"  processed=\(.blocksProcessed) attributed=\(.blocksAttributed) end=\(.endBlock) dur=\(.durationMs)ms"' 2>/dev/null || true
              new_lag=$(read_lag)
              echo "  lag now: $new_lag"
              if [ "$new_lag" -gt 0 ] && [ "$new_lag" -lt "$LAG_THRESHOLD" ]; then
                echo "caught up, stopping block burst"
                break
              fi
              i=$((i + 1))
            done

            echo "also bursting MEV indexer 4x..."
            for j in 1 2 3 4; do
              echo "--- mev call $j ---"
              call_with_retry "$BASE/api/cron/index-mev" | \
                jq -r '"  scanned=\(.blocksScanned) inserted=\(.rowsInserted) end=\(.endBlock) hitBudget=\(.hitBudget)"' 2>/dev/null || true
            done
          else
            echo "block indexer at-head, skipping burst (zero-cost idle)"
          fi

          echo "burst-catchup complete"
